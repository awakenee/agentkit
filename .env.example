# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Model API key (OpenAI, Groq, Together, ... any OpenAI-compatible endpoint)
OPENAI_API_KEY=

# Strongly recommended: comma-separated Telegram user ids allowed to use the bot.
# Leave empty to allow everyone (and let anyone spend your model credits).
AGENT_ALLOWED_USERS=

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# AGENT_MODEL=gpt-4o-mini
# AGENT_NAME=AgentKit
# AGENT_SYSTEM=
# AGENT_MEMORY_DIR=/data/memory
# AGENT_WORKDIR=/data/workspace
# Set by the platform on Render/Railway/Fly; enables GET /health
# PORT=8080
# Set to 0 to disable the http_get tool
# AGENT_ALLOW_NETWORK=1
